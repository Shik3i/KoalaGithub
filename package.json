{
	"name": "koalagithub",
	"version": "0.1.5",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "vite dev --open",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.6",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.23.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.7",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.72.0",
		"vite": "^6.0.3",
		"vitest": "^2.1.8"
	},
	"overrides": {
		"cookie": "0.7.2"
	},
	"dependencies": {
		"phosphor-svelte": "^3.1.1"
	}
}
